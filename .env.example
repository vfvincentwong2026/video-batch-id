# Video Batch ID —— 本地开发环境变量（复制为 .env 使用，或直接 setx / $env: 设置）
# 全部可选：不设置任何一项，系统以 ffmpeg-shotcut 结构解析 + mock 生成链路完整可跑。

# ---- 语义解析（vlm-api provider）：设置后立即点亮真实画面语义 / Hook / 口播转录 ----
# OpenAI 官方（有 OpenAI 账号即可，gpt-4o-mini  vision，一次解析约几分钱）：
VBID_VLM_API_KEY=sk-your-key-here
# 国内直连中转（可选，OpenAI 兼容协议即可：DashScope / 智谱 / SiliconFlow …）：
# VBID_VLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VBID_VLM_MODEL=gpt-4o-mini
# 多模型回退链（逗号分隔；429/402/空响应自动换下一个）：
# VBID_VLM_MODEL=google/gemma-4-26b-a4b-it:free,nvidia/nemotron-3.5-super-vl:free,openai/gpt-4o-mini
# 送 VLM 的最大代表帧数（默认 12）：
# VBID_VLM_MAX_SHOTS=15

# ---- 服务 ----
# PORT=8000
# VBID_PROFILE=local
# VBID_DB_PATH=./vbid.sqlite
